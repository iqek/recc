# Copy this file to .env and fill in the values below.

PORT=3000

# Local Postgres from docker-compose.yml (host port 5433, not the Postgres
# default 5432 - avoids clashing with a native Postgres install, if you have
# one). Change if you're pointing at a different database.
DATABASE_URL=postgres://recc:recc@localhost:5433/recc

# Required for game search/trending. Free key: https://rawg.io/apidocs
RAWG_API_KEY=your_rawg_key_here

# Required for movie search/trending. Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_key_here

# Optional. Google Books works without a key at a lower daily quota.
# Get one at https://console.cloud.google.com/ if you want a higher limit.
GOOGLE_BOOKS_API_KEY=

# Anime/manga (AniList) and visual novels (VNDB) need no key at all.

# First-run only: creates one account automatically and hands it any
# favorites/lists that existed before accounts were added. Change the
# password (or just register your own account and stop using this one).
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=changeme
